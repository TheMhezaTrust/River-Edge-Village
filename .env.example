# ---- Database (Postgres for production / Vercel) ----
# Neon pooled connection string looks like:
# postgresql://USER:PASSWORD@ep-xxxx-REGION.pooler.neon.tech/DBNAME?sslmode=require
# DATABASE_URL is the POOLED string (app runtime).
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler/neONDB?sslmode=require"
# DIRECT_DATABASE_URL is the same string with "-pooler" removed from the host.
# Prisma CLI uses it for `db push`/`migrate` (DDL needs a direct connection).
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# ---- Auth ----
# Strong random secret (generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
JWT_SECRET="replace-with-a-strong-random-secret"

# ---- Public site URL (SEO metadataBase / og:url) ----
NEXT_PUBLIC_SITE_URL="https://themhezatrust.co.za"

# ---- Main Administrator (optional) ----
# Staff account that holds the backend-only SUPER_ADMIN role: it displays as
# "Administrator" everywhere, is the only role that can open /workstation/analytics,
# and is the only account with security-question password recovery. The role is
# applied automatically the first time this account signs in or opens the
# workstation. Default: bongani.sifiniza@themhezatrust.local
SUPER_ADMIN_EMAIL="bongani.sifiniza@themhezatrust.local"
# Salt for the hashed visitor IP stored in PageView.ipHash. Falls back to
# JWT_SECRET. Changing it restarts the unique-visitor counts (old hashes no
# longer match new ones).
ANALYTICS_SALT=""

# ---- Outbound email (Resend) ----
# Used for three things: emailing a customer from the workstation ("Reply to
# Customer" on an inquiry), notifying the Trust inbox when a website inquiry
# arrives, and sending members their portal access / password-reset link. Without
# RESEND_API_KEY the workstation buttons report that outbound email is not
# configured, inquiry notifications are skipped (the inquiry is still saved), and
# the member portal falls back to a staff-set temporary password.
# Create the key at https://resend.com/api-keys and verify themhezatrust.co.za
# under Domains (it supplies the SPF/DKIM records to add at your DNS provider).
RESEND_API_KEY=""
# Must be an address on the verified domain.
EMAIL_FROM="The Mheza Trust <inquiries@themhezatrust.co.za>"
# Where a customer's answer lands. Defaults to the Trust's published Gmail inbox.
EMAIL_REPLY_TO="themhezatrust@gmail.com"

# ---- Object storage (Vercel Blob) ----
# Used by the photo gallery today, and by member file uploads once they ship.
# Create a store at https://vercel.com/dashboard/stores and copy the token from
# the store's API Tokens tab. Both values are unprefixed (NOT NEXT_PUBLIC_) —
# they are server-only secrets and must never be exposed to the browser.
BLOB_READ_WRITE_TOKEN=""
# The store id, shown on the store's settings page (e.g. store_xxxxxxxxxxxxxxxx).
BLOB_STORE_ID=""

# ---- "Mheza" public chat assistant (OpenAI-compatible; DeepSeek by default) ----
DEEPSEEK_API_KEY=""
LLM_BASE_URL="https://api.deepseek.com/v1"
LLM_MODEL="deepseek-chat"

# ---- Feature flags ----
# Member/staff document upload+download is DISABLED for launch (no object storage).
# Document API routes return 410 Gone and the UI entry points are hidden.
