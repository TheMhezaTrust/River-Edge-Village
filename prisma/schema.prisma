// Prisma schema for The Mheza Trust
// Production runs on PostgreSQL (Neon). DATABASE_URL is the pooled connection
// used by the app at runtime; DIRECT_DATABASE_URL is the non-pooled connection
// used by the Prisma CLI for schema pushes/migrations (JSON-ish data is stored
// as strings, so the schema is provider-agnostic).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ---------- Identity & access ----------

model User {
  id                   Int                   @id @default(autoincrement())
  name                 String
  email                String                @unique
  password             String
  role                 String // SUPER_ADMIN (backend-only, displays as Administrator) | ADMIN | FINANCE | PLOTS
  phone                String?
  title                String?
  isActive             Boolean               @default(true)
  lastLoginAt          DateTime?
  createdAt            DateTime              @default(now())
  messagesSent         Message[]             @relation("messagesFrom")
  messagesGot          Message[]             @relation("messagesTo")
  auditLogs            AuditLog[]
  notifications        Notification[]
  inquiries            Inquiry[]
  inquiryReplies       InquiryReply[]
  documents            Document[]
  memberDocuments      MemberDocument[]
  tasks                Task[]
  memberTokens         MemberToken[]
  memberChangeRequests MemberChangeRequest[]
}

model Member {
  id                 Int                   @id @default(autoincrement())
  fullName           String
  idNumber           String?
  dateOfBirth        String?
  gender             String?
  maritalStatus      String?
  physicalAddress    String?
  postalAddress      String?
  phone              String
  email              String                @unique
  password           String? // portal login (bcrypt hash); null = portal not yet activated
  purchasePrice      Float?
  purchaseDate       DateTime? // date joined / date of purchase for the member as a whole
  paymentPlan        String? // FULL | PLAN_6 | PLAN_12 | PLAN_24
  beneficiaries      String? // JSON string
  notes              String?
  isActive           Boolean               @default(true)
  mustChangePassword Boolean               @default(false) // set when the office issued a temporary password
  lastLoginAt        DateTime?
  createdAt          DateTime              @default(now())
  plots              Plot[]
  payments           Payment[]
  documents          MemberDocument[]
  tokens             MemberToken[]
  changeRequests     MemberChangeRequest[]
}

// Single-use links that let a member set their own portal password. Only the
// SHA-256 hash is stored, so reading the table cannot be turned into a login.
// ACTIVATE is the office's first-time invitation, RESET is a forgotten password;
// both expire and are consumed on use.
model MemberToken {
  id          String    @id @default(cuid())
  memberId    Int
  member      Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  tokenHash   String    @unique
  purpose     String    @default("ACTIVATE") // ACTIVATE | RESET
  expiresAt   DateTime
  usedAt      DateTime?
  createdById Int?
  createdBy   User?     @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([memberId])
}

// A member cannot edit their own name or ID number — those identify the plot
// holder on the Trust's records — so a change is a request the office decides on.
model MemberChangeRequest {
  id            Int       @id @default(autoincrement())
  memberId      Int
  member        Member    @relation(fields: [memberId], references: [id], onDelete: Cascade)
  field         String // fullName | idNumber
  currentValue  String?
  proposedValue String
  reason        String?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED
  decidedById   Int?
  decidedBy     User?     @relation(fields: [decidedById], references: [id])
  decidedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([memberId])
  @@index([status])
}

// ---------- Projects & plots ----------

model Project {
  id            Int     @id @default(autoincrement())
  name          String
  slug          String  @unique
  description   String
  location      String
  address       String?
  status        String // ACTIVE | PLANNING | COMPLETED
  farmSizeHa    Float?
  plotCount     Int?
  familyCount   Int?
  promoPrice    Float?
  standardPrice Float?
  promoEndsAt   String?
  thumbnail     String?
  timeline      String? // JSON string [{label, status, description, date}]
  plots         Plot[]
}

model Plot {
  id          Int       @id @default(autoincrement())
  number      String
  sizeSqm     Int       @default(800)
  price       Float
  status      String    @default("AVAILABLE") // AVAILABLE | RESERVED | SOLD
  description String?
  x           Float // plan-pixel centre on the survey layout (see lib/plan-layout.js)
  y           Float // plan-pixel centre on the survey layout
  block       String? // block/zone label e.g. "A"
  purchasedAt DateTime? // when this erf was bought; a member's plots may have different dates
  certificateIssuedAt DateTime? // null = Certificate of Land Use not yet issued
  projectId   Int
  project     Project   @relation(fields: [projectId], references: [id])
  memberId    Int?
  member      Member?   @relation(fields: [memberId], references: [id])
  payments    Payment[]
  inquiries   Inquiry[]

  @@unique([projectId, number])
}

// ---------- Sales pipeline ----------

model Inquiry {
  id           Int            @id @default(autoincrement())
  name         String
  email        String
  phone        String
  idNumber     String?
  plotId       Int?
  plot         Plot?          @relation(fields: [plotId], references: [id])
  message      String?
  source       String         @default("WEBSITE") // WEBSITE | PHONE | EMAIL | WALK_IN
  status       String         @default("NEW") // NEW | CONTACTED | CONVERTED | CLOSED
  assignedTo   Int?
  assignee     User?          @relation(fields: [assignedTo], references: [id])
  followUpDate String?
  notes        String?
  createdAt    DateTime       @default(now())
  replies      InquiryReply[]
}

// Customer-facing replies sent from an inquiry's detail screen. This is the
// inquiry's communication history (the equivalent of DepartmentLog for
// government engagements). Failed sends are kept too, with the provider's
// error, so staff can see that a customer was never actually reached.
model InquiryReply {
  id         Int      @id @default(autoincrement())
  inquiryId  Int
  inquiry    Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  toEmail    String
  subject    String
  body       String
  status     String   @default("SENT") // SENT | FAILED
  providerId String? // Resend message id
  error      String?
  sentById   Int?
  sentBy     User?    @relation(fields: [sentById], references: [id])
  createdAt  DateTime @default(now())

  @@index([inquiryId])
}

model Payment {
  id        Int      @id @default(autoincrement())
  amount    Float
  date      DateTime @default(now())
  method    String // EFT | CASH | CARD | DEBIT_ORDER
  reference String?
  note      String?
  memberId  Int
  member    Member   @relation(fields: [memberId], references: [id])
  plotId    Int?
  plot      Plot?    @relation(fields: [plotId], references: [id])
  income    Income?
}

// ---------- Finance ----------

model Income {
  id          Int      @id @default(autoincrement())
  date        DateTime
  description String
  project     String?
  amount      Float
  category    String // PLOT_SALE | FEE | DONATION | OTHER
  method      String?
  reference   String?
  // Set when the row was created automatically from a member payment, so
  // correcting that payment can correct its income entry too. Null for income
  // Finance captured by hand. SET NULL rather than CASCADE: if a payment row is
  // ever removed by another path the income record survives instead of vanishing
  // silently out of the financial history.
  paymentId   Int?     @unique
  payment     Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime
  description String
  category    String // SALARY | CONTRACTOR | SUPPLIES | FEES | LEGAL | MARKETING | OTHER
  amount      Float
  vendor      String?
  project     String?
}

// ---------- Formal accounting: chart of accounts and double-entry ledger ----------
//
// Income and Expense above are the operational records staff capture day to day.
// Everything below is the formal bookkeeping those records post into, so that a
// General Ledger, Trial Balance, P&L and Balance Sheet can be produced for SARS and
// for an auditor without re-keying anything. All of it is auto-provisioned at
// runtime (lib/provision.js) because the production database cannot be reached from
// a development machine.

model Account {
  id        Int      @id @default(autoincrement())
  code      String   @unique
  name      String
  type      String // ASSET | LIABILITY | EQUITY | REVENUE | EXPENSE
  // Seeded with the chart of accounts. A system account can be renamed or
  // deactivated but not deleted, because historical journal lines point at it.
  isSystem  Boolean  @default(false)
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  lines     JournalLine[]
}

// One formal transaction. txnNo is the unique Transaction ID that appears on every
// report and export; amount is signed-positive and the direction lives in the lines.
model Transaction {
  id          Int      @id @default(autoincrement())
  txnNo       String   @unique
  type        String // INCOME | EXPENSE | ADJUSTMENT | OPENING | DISTRIBUTION
  date        DateTime
  description String
  amount      Float
  periodKey   String // "YYYY-MM" the date falls in — what period locking keys on
  // Where the row came from, so a correction to a member's payment can be followed
  // through to the ledger entry it produced. Null for entries made directly here.
  sourceType  String? // INCOME | EXPENSE | DISTRIBUTION | OPENING
  sourceId    Int?
  // Present but unused until the Trust's VAT registration is confirmed: a vendor
  // number is not yet on file, so nothing may imply VAT is being charged.
  vatApplicable Boolean @default(false)
  vatRate       Float   @default(0)
  vatAmount     Float   @default(0)
  // A locked period cannot be edited, so a correction posts a new entry that points
  // back at the one it fixes. Both rows stay, which is what an auditor expects.
  reversesId    Int?
  createdById   Int?
  createdAt     DateTime @default(now())
  lines         JournalLine[]

  @@index([periodKey])
  @@index([date])
  @@index([type])
}

model JournalLine {
  id            Int    @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  accountId     Int
  account       Account   @relation(fields: [accountId], references: [id])
  debit         Float  @default(0)
  credit        Float  @default(0)
  memo          String?
  // Set on the expense side of a transaction to say which jar paid for it, which is
  // what reduces that jar's available balance.
  budgetCategoryId Int?

  @@index([transactionId])
  @@index([accountId])
}

// ---------- Fund accounting: the jars ----------

model BudgetCategory {
  id         Int      @id @default(autoincrement())
  name       String   @unique
  // Share of every incoming payment routed to this jar. The active categories must
  // always total 100. Changing it affects future payments only — each Allocation
  // snapshots the percentage that was in force when the money arrived.
  percentage Float
  isSystem   Boolean  @default(false)
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  allocations Allocation[]
}

model Allocation {
  id               Int  @id @default(autoincrement())
  transactionId    Int
  budgetCategoryId Int
  budgetCategory   BudgetCategory @relation(fields: [budgetCategoryId], references: [id])
  percentage       Float
  amount           Float
  createdAt        DateTime @default(now())

  @@index([transactionId])
  @@index([budgetCategoryId])
}

model FinancialPeriod {
  id         Int       @id @default(autoincrement())
  periodKey  String    @unique // "2026-10" for a month, "2026" for a year
  kind       String // MONTH | YEAR
  status     String    @default("OPEN") // OPEN | CLOSED
  closedById Int?
  closedAt   DateTime?
  createdAt  DateTime  @default(now())
}

model OpeningBalance {
  id            Int      @id @default(autoincrement())
  accountId     Int
  asAt          DateTime
  debit         Float    @default(0)
  credit        Float    @default(0)
  note          String?
  // The OPENING transaction these figures were posted as, so the Balance Sheet can
  // be built purely from journal lines.
  transactionId Int?     @unique
  createdById   Int?
  createdAt     DateTime @default(now())

  @@unique([accountId, asAt])
}

// Money the Trust pays OUT to a beneficiary. Members normally pay the Trust for an
// erf rather than the other way round, so this stays empty until a distribution is
// actually made — and an empty IT3(t) report is the truthful answer, not a gap.
model Distribution {
  id                Int      @id @default(autoincrement())
  date              DateTime
  recipientName     String
  recipientIdNumber String?
  memberId          Int?
  amount            Float
  nature            String // INCOME_DISTRIBUTION | CAPITAL_RETURN
  note              String?
  transactionId     Int?     @unique
  createdById       Int?
  createdAt         DateTime @default(now())

  @@index([date])
}

model Employee {
  id        Int     @id @default(autoincrement())
  name      String
  jobTitle  String
  salary    Float // monthly gross
  paye      Float   @default(0)
  uif       Float   @default(0)
  sdl       Float   @default(0)
  startDate String?
  isActive  Boolean @default(true)
}

// ---------- Documents ----------

model Document {
  id           Int      @id @default(autoincrement())
  title        String
  folder       String // TRUST | PROJECT | LEGAL | FINANCIAL | MEMBER | DEPARTMENT | MINUTES
  tags         String?
  description  String?
  filePath     String
  fileName     String
  mimeType     String?
  sizeKb       Int?
  permissions  String? // comma-separated roles; null = all internal roles
  uploadedById Int?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  version      Int      @default(1)
  createdAt    DateTime @default(now())
}

// A member's own vault: the signed and stamped paperwork the Trust issues to them
// (the Acknowledgement of Payment and Plot Allocation, a Certificate of Land Use).
// The file itself lives in Vercel Blob and filePath holds that URL. The URL is
// never sent to a browser — a Blob link is permanent and public, and these are
// signed legal documents carrying ID numbers — so every download goes through a
// route that first proves who is asking. Auto-provisioned (lib/provision.js).
model MemberDocument {
  id           Int      @id @default(autoincrement())
  title        String
  category     String // ALLOCATION | CONTRACT | CERTIFICATE | ID_COPY | BENEFICIARY_FORM | BUILDING_PLAN | OTHER
  filePath     String
  fileName     String
  sizeKb       Int?
  memberId     Int
  member       Member   @relation(fields: [memberId], references: [id])
  uploadedById Int?
  uploadedBy   User?    @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([memberId])
}

// ---------- Department engagement ----------

model Department {
  id                 Int             @id @default(autoincrement())
  name               String
  contactPerson      String?
  phone              String?
  email              String?
  status             String          @default("PENDING") // PENDING | IN_PROGRESS | APPROVED | NO_OBJECTION | REJECTED
  notes              String?
  followUpDate       String?
  documentsSubmitted String? // JSON string list
  responsesReceived  String? // JSON string list
  logs               DepartmentLog[]
}

model DepartmentLog {
  id           Int        @id @default(autoincrement())
  date         DateTime   @default(now())
  method       String // EMAIL | PHONE | MEETING | LETTER
  summary      String
  nextSteps    String?
  departmentId Int
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
}

// ---------- Tasks ----------

model Task {
  id          Int      @id @default(autoincrement())
  title       String
  description String?
  status      String   @default("TODO") // TODO | IN_PROGRESS | COMPLETED
  priority    String   @default("MEDIUM") // LOW | MEDIUM | HIGH | URGENT
  dueDate     String?
  assignedTo  Int?
  assignee    User?    @relation(fields: [assignedTo], references: [id])
  createdBy   Int?
  createdAt   DateTime @default(now())
}

// ---------- Communication ----------

model Message {
  id        Int      @id @default(autoincrement())
  subject   String
  body      String
  fromId    Int
  from      User     @relation("messagesFrom", fields: [fromId], references: [id])
  toId      Int
  to        User     @relation("messagesTo", fields: [toId], references: [id])
  isRead    Boolean  @default(false)
  isDraft   Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Announcement {
  id        Int      @id @default(autoincrement())
  title     String
  body      String
  audience  String   @default("INTERNAL") // INTERNAL | PUBLIC
  category  String?
  authorId  Int?
  createdAt DateTime @default(now())
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  text      String
  type      String   @default("INFO")
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model SiteContent {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// Records a visitor's acceptance of the River Edge Terms and Conditions.
// userId holds the logged-in user's id when present, otherwise an anonymous
// session id generated in the browser. The table is auto-provisioned at runtime
// (CREATE TABLE IF NOT EXISTS in the API route) so no manual migration is needed.
model TermsAcceptance {
  id         String   @id @default(cuid())
  userId     String
  acceptedAt DateTime @default(now())
  ipAddress  String?
}

// Public photo gallery. Image files live in Vercel Blob; this row stores only
// the metadata (the public Blob URL plus optional caption). The table is
// auto-provisioned at runtime (CREATE TABLE IF NOT EXISTS in the API route) so
// no manual migration is needed.
model GalleryImage {
  id          String   @id @default(cuid())
  url         String
  title       String?
  description String?
  createdAt   DateTime @default(now())
}

// Two-step password recovery for the Main Administrator (SUPER_ADMIN). Answers
// are stored as bcrypt hashes, never in plain text, and are only ever read back
// inside the recovery flow. failedAttempts/lockedUntil drive the brute-force
// lockout. The table is auto-provisioned at runtime (CREATE TABLE IF NOT EXISTS
// in lib/provision.js) so no manual migration is needed.
model SecurityQuestion {
  id             String    @id @default(cuid())
  userId         Int       @unique
  question1      String
  answer1Hash    String
  question2      String
  answer2Hash    String
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  updatedAt      DateTime  @default(now()) @updatedAt
}

// Public-website traffic. ipHash is a salted SHA-256 of the visitor IP, so
// unique visitors can be counted without storing raw IP addresses. Only public
// pages are recorded (see PUBLIC_PATHS in lib/analytics.js). Auto-provisioned
// at runtime (lib/provision.js).
model PageView {
  id        Int      @id @default(autoincrement())
  path      String
  ipHash    String
  timestamp DateTime @default(now())

  @@index([timestamp])
  @@index([path])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  entity    String?
  entityId  String?
  details   String?
  // What a change replaced, kept in their own columns so an auditor can read the log
  // without parsing the details blob. Null where the action is not a correction.
  oldValue  String?
  newValue  String?
  // Tamper evidence. Each row carries a hash of its own contents chained to the row
  // before it, so altering, reordering or silently inserting an entry breaks the
  // chain and shows up when the log is verified. It cannot stop someone with
  // database-level access deleting rows outright — only an offsite copy can.
  entryHash String?
  prevHash  String?
  createdAt DateTime @default(now())
}
